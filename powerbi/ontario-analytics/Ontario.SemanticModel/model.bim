        "toCardinality": "one",
        "isActive": true
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DataFolder\", \"FactPHO\", \"FactOntario\", \"DimIndicator\", \"DimPHU\", \"DimYear\", \"FactWaitProvince\", \"FactWaitRegion\", \"DimProcedure\", \"DimWaitRegion\"]"
      }
    ]
  }
}
