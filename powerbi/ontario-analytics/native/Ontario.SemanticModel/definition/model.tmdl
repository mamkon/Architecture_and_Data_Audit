model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-CA
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["SourceFolder", "SourcePHO", "SourceCIHI", "CIHIWide", "FactPHO", "FactOntario", "DimIndicator", "DimPHU", "DimYear", "FactWaitProvince", "FactWaitRegion", "DimProcedure", "DimWaitRegion", "SelectPHOYear", "SelectCIHIYear"]

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table FactPHO
ref table FactOntario
ref table DimIndicator
ref table DimPHU
ref table DimYear
ref table FactWaitProvince
ref table FactWaitRegion
ref table DimProcedure
ref table DimWaitRegion
ref table SelectPHOYear
ref table SelectCIHIYear

